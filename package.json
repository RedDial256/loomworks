{
  "name": "loomworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "scripts/worktree-setup.sh",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "security": "node scripts/security.mjs",
    "security:baseline": "node scripts/security.mjs --update"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@red_dial/rn-tooling-config": "0.2.0-alpha.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.9.9",
    "rnsec": "1.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
