{
  "version": 1,
  "minimums": {
    "expo": ">=58.0.21 <59",
    "react-native": ">=0.88.1",
    "react": ">=19.3.0",
    "react-native-unistyles": "^3.7.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "~0.13.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "babel-preset-expo": "~58.0.0"
  },
  "items": {
    "theme": {
      "kind": "theme",
      "description": "Light and dark themes, design tokens, the Unistyles setup and useThemeMode (system / light / dark, persisted in AsyncStorage). Installed by `loom init`.",
      "files": [
        "theme/contract.ts",
        "theme/dark.ts",
        "theme/elevation.ts",
        "theme/index.ts",
        "theme/light.ts",
        "theme/motion.ts",
        "theme/palette.ts",
        "theme/spacing.ts",
        "theme/typography.ts",
        "theme/unistyles.ts",
        "theme/useThemeMode.ts",
        "theme/useThemeMode.types.ts"
      ],
      "packages": {
        "react-native-unistyles": "^3.7.0",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-gesture-handler": "^3.3.0",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-async-storage/expo-with-async-storage": "^1.0.0"
      }
    },
    "a11y": {
      "kind": "util",
      "description": "easyA11y: maps a simplified a11y object to legacy accessibility props.",
      "files": ["utils/a11y/easyA11y.ts", "utils/a11y/easyA11y.types.ts"]
    },
    "capitalize": {
      "kind": "util",
      "description": "capitalize: uppercases the first character of a string, keeping literal types precise.",
      "files": ["utils/capitalize/capitalize.ts"]
    },
    "reduced-motion": {
      "kind": "hook",
      "description": "useReducedMotion and useMotion: reactive reduced-motion setting resolved into the none / fade / keep behaviors, plus Reanimated easings from the theme.",
      "files": [
        "hooks/reduced-motion/useReducedMotion.ts",
        "hooks/reduced-motion/useReducedMotion.types.ts"
      ],
      "sdkPackages": ["react-native-reanimated", "react-native-worklets"]
    },
    "box": {
      "kind": "component",
      "description": "Layout primitive: a View with theme spacing and surfaces.",
      "files": ["components/box/Box.tsx", "components/box/Box.types.ts"],
      "dependencies": ["a11y"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "card": {
      "kind": "component",
      "description": "Raised surface built on Box: lg radius and an elevation level, with the dark-mode tint and hairline.",
      "files": ["components/card/Card.tsx", "components/card/Card.types.ts"],
      "dependencies": ["box"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "divider": {
      "kind": "component",
      "description": "Horizontal or vertical hairline separator, hidden from screen readers.",
      "files": [
        "components/divider/Divider.tsx",
        "components/divider/Divider.types.ts"
      ],
      "dependencies": ["a11y"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "input": {
      "kind": "component",
      "description": "Styled TextInput with a type preset, label, hint, error, required, controlled or uncontrolled value, validation (required, any Standard Schema, a validate callback) on blur then debounced on change, a ref (get, set, reset, focus, blur, clear, validate) and a loading skeleton.",
      "files": [
        "components/input/Input.tsx",
        "components/input/Input.types.ts",
        "components/input/Input.utils.ts",
        "components/input/components/InputLabel.tsx",
        "components/input/components/InputMessage.tsx"
      ],
      "dependencies": ["a11y", "debounce", "skeleton", "text"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "skeleton": {
      "kind": "component",
      "description": "Loading placeholder with an opacity pulse; a static block under reduced motion.",
      "files": [
        "components/skeleton/Skeleton.tsx",
        "components/skeleton/Skeleton.types.ts"
      ],
      "dependencies": ["a11y", "reduced-motion"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      },
      "sdkPackages": ["react-native-reanimated", "react-native-worklets"]
    },
    "spinner": {
      "kind": "component",
      "description": "Themed ActivityIndicator with S / M / L sizes and a color role; keeps spinning under reduced motion.",
      "files": [
        "components/spinner/Spinner.tsx",
        "components/spinner/Spinner.types.ts"
      ],
      "dependencies": ["a11y"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "switch": {
      "kind": "component",
      "description": "Controlled native Switch with theme colors, a pressable labelled row, disabled and loading states.",
      "files": [
        "components/switch/Switch.tsx",
        "components/switch/Switch.types.ts",
        "components/switch/Switch.utils.ts",
        "components/switch/components/SwitchBare.tsx",
        "components/switch/components/SwitchLoading.tsx",
        "components/switch/components/SwitchRow.tsx",
        "components/switch/components/ThemedSwitch.tsx"
      ],
      "dependencies": ["a11y", "skeleton", "text"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "text": {
      "kind": "component",
      "description": "Themed text with typography presets and a loading skeleton.",
      "files": ["components/text/Text.tsx", "components/text/Text.types.ts"],
      "dependencies": ["a11y", "skeleton"],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      }
    },
    "pressable": {
      "kind": "component",
      "description": "Touch enabler over the Gesture Handler Pressable: pressed state for style and children, a11y, disabled, and a hitSlop helper that reaches the minimum touch target.",
      "files": [
        "components/pressable/Pressable.tsx",
        "components/pressable/Pressable.types.ts"
      ],
      "dependencies": ["a11y"],
      "packages": {
        "react-native-gesture-handler": "^3.3.0"
      }
    },
    "button": {
      "kind": "component",
      "description": "Button over Pressable with solid, subtle, outline, ghost, link and text variants, color families, S / M / L sizes, press feedback, and loading and pending states.",
      "files": [
        "components/button/Button.tsx",
        "components/button/Button.types.ts"
      ],
      "dependencies": [
        "a11y",
        "capitalize",
        "pressable",
        "reduced-motion",
        "skeleton",
        "spinner",
        "text"
      ],
      "packages": {
        "react-native-unistyles": "^3.7.0"
      },
      "sdkPackages": ["react-native-reanimated", "react-native-worklets"]
    },
    "debounce": {
      "kind": "hook",
      "description": "useDebounce: returns a value once it has stopped changing for a delay.",
      "files": ["hooks/debounce/useDebounce.ts"]
    },
    "timeout": {
      "kind": "hook",
      "description": "useTimeout: owns one setTimeout, cleared on unmount, with set, clear and a ref to the timer.",
      "files": [
        "hooks/timeout/useTimeout.ts",
        "hooks/timeout/useTimeout.types.ts"
      ]
    },
    "boolean": {
      "kind": "hook",
      "description": "useBoolean: boolean state with stable set, toggle, setter (cached handler per value) and reset.",
      "files": [
        "hooks/boolean/useBoolean.ts",
        "hooks/boolean/useBoolean.types.ts"
      ]
    }
  }
}
