{
  "version": 1,
  "minimums": {
    "expo": ">=56.0.23 <58",
    "react-native": ">=0.85.3",
    "react": ">=19.2.3",
    "react-native-unistyles": "^3.5.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-gesture-handler": "^3.3.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "babel-preset-expo": "~56.0.0 || ~57.0.0"
  },
  "items": {
    "theme": {
      "kind": "theme",
      "description": "Light and dark themes, design tokens and the Unistyles setup. Installed by `loom init`.",
      "files": [
        "theme/contract.ts",
        "theme/dark.ts",
        "theme/elevation.ts",
        "theme/index.ts",
        "theme/light.ts",
        "theme/motion.ts",
        "theme/palette.ts",
        "theme/spacing.ts",
        "theme/typography.ts",
        "theme/unistyles.ts"
      ],
      "packages": {
        "react-native-unistyles": "^3.5.2",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-gesture-handler": "^3.3.0",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-async-storage/expo-with-async-storage": "^1.0.0"
      }
    },
    "box": {
      "kind": "component",
      "description": "Layout primitive: a View with theme spacing and surfaces.",
      "files": ["components/box/Box.tsx", "components/box/Box.types.ts"],
      "packages": {
        "react-native-unistyles": "^3.5.2"
      }
    },
    "text": {
      "kind": "component",
      "description": "Themed text with typography presets.",
      "files": ["components/text/Text.tsx", "components/text/Text.types.ts"],
      "packages": {
        "react-native-unistyles": "^3.5.2"
      }
    }
  }
}
