{
  "version": 1,
  "minimums": {
    "expo": ">=56.0.23 <58",
    "react-native": ">=0.85.3",
    "react": ">=19.2.3",
    "react-native-unistyles": "^3.5.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.3.1",
    "react-native-worklets": ">=0.8.3 <0.11",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "babel-preset-expo": "~56.0.0 || ~57.0.0"
  },
  "items": {
    "theme": {
      "kind": "theme",
      "description": "Light and dark themes, design tokens and the Unistyles setup. Installed by `loom init`.",
      "files": [
        "theme/contract.ts",
        "theme/dark.ts",
        "theme/elevation.ts",
        "theme/index.ts",
        "theme/light.ts",
        "theme/motion.ts",
        "theme/palette.ts",
        "theme/spacing.ts",
        "theme/typography.ts",
        "theme/unistyles.ts"
      ],
      "packages": {
        "react-native-unistyles": "^3.5.2",
        "react-native-nitro-modules": "^0.37.1",
        "react-native-gesture-handler": "^3.3.0",
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-async-storage/expo-with-async-storage": "^1.0.0"
      }
    },
    "a11y": {
      "kind": "util",
      "description": "easyA11y: maps a simplified a11y object to legacy accessibility props.",
      "files": ["utils/a11y/easyA11y.ts", "utils/a11y/easyA11y.types.ts"]
    },
    "reduced-motion": {
      "kind": "hook",
      "description": "useReducedMotion: reactive reduced-motion setting, plus resolveMotion for the none / fade / keep behaviors.",
      "files": [
        "hooks/reduced-motion/useReducedMotion.ts",
        "hooks/reduced-motion/useReducedMotion.types.ts"
      ],
      "sdkPackages": ["react-native-reanimated", "react-native-worklets"]
    },
    "box": {
      "kind": "component",
      "description": "Layout primitive: a View with theme spacing and surfaces.",
      "files": ["components/box/Box.tsx", "components/box/Box.types.ts"],
      "dependencies": ["a11y"],
      "packages": {
        "react-native-unistyles": "^3.5.2"
      }
    },
    "skeleton": {
      "kind": "component",
      "description": "Loading placeholder with an opacity pulse that keeps running under reduced motion.",
      "files": [
        "components/skeleton/Skeleton.tsx",
        "components/skeleton/Skeleton.types.ts"
      ],
      "dependencies": ["a11y", "reduced-motion"],
      "packages": {
        "react-native-unistyles": "^3.5.2"
      },
      "sdkPackages": ["react-native-reanimated", "react-native-worklets"]
    },
    "text": {
      "kind": "component",
      "description": "Themed text with typography presets and a loading skeleton.",
      "files": ["components/text/Text.tsx", "components/text/Text.types.ts"],
      "dependencies": ["a11y", "skeleton"],
      "packages": {
        "react-native-unistyles": "^3.5.2"
      }
    }
  }
}
