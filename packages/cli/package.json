{
  "name": "@red_dial/loom",
  "version": "0.0.0",
  "description": "Loom CLI: adds components to your project.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "unrun": "^0.3.1",
    "vitest": "^5.0.4"
  }
}
