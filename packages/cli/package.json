{
  "name": "@red_dial/loom",
  "version": "0.0.0",
  "description": "Loom CLI: adds components to your project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedDial256/loomworks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RedDial256/loomworks/tree/main/packages/cli#readme",
  "bugs": "https://github.com/RedDial256/loomworks/issues",
  "keywords": [
    "react-native",
    "expo",
    "unistyles",
    "ui-kit",
    "components",
    "cli"
  ],
  "type": "module",
  "bin": {
    "loom": "./dist/bin.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.1",
    "unrun": "^0.3.1",
    "vitest": "^5.0.4"
  }
}
